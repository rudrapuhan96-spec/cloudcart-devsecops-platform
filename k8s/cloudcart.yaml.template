apiVersion: v1
kind: Namespace
metadata:
  name: cloudcart
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: cloudcart-mysql-init
  namespace: cloudcart
data:
  01-schema.sql: |
__SCHEMA__
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cloudcart-mysql
  namespace: cloudcart
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: cloudcart-mysql
  template:
    metadata:
      labels:
        app: cloudcart-mysql
    spec:
      containers:
        - name: mysql
          image: mysql:8.4
          ports:
            - containerPort: 3306
          env:
            - name: MYSQL_DATABASE
              value: cloudcart
            - name: MYSQL_USER
              value: cloudcart
            - name: MYSQL_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: cloudcart-secrets
                  key: DB_PASSWORD
            - name: MYSQL_ROOT_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: cloudcart-secrets
                  key: MYSQL_ROOT_PASSWORD
          readinessProbe:
            exec:
              command: ["sh", "-c", "mysqladmin ping -h 127.0.0.1 -u root -p\"$MYSQL_ROOT_PASSWORD\""]
            initialDelaySeconds: 20
            periodSeconds: 10
          livenessProbe:
            exec:
              command: ["sh", "-c", "mysqladmin ping -h 127.0.0.1 -u root -p\"$MYSQL_ROOT_PASSWORD\""]
            initialDelaySeconds: 60
            periodSeconds: 20
          volumeMounts:
            - name: mysql-data
              mountPath: /var/lib/mysql
            - name: init-schema
              mountPath: /docker-entrypoint-initdb.d/01-schema.sql
              subPath: 01-schema.sql
      volumes:
        - name: mysql-data
          emptyDir: {}
        - name: init-schema
          configMap:
            name: cloudcart-mysql-init
---
apiVersion: v1
kind: Service
metadata:
  name: cloudcart-mysql
  namespace: cloudcart
spec:
  selector:
    app: cloudcart-mysql
  ports:
    - name: mysql
      port: 3306
      targetPort: 3306
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cloudcart-backend
  namespace: cloudcart
spec:
  replicas: 2
  selector:
    matchLabels:
      app: cloudcart-backend
  template:
    metadata:
      labels:
        app: cloudcart-backend
    spec:
      containers:
        - name: backend
          image: __BACKEND_IMAGE__
          imagePullPolicy: Always
          ports:
            - containerPort: 4000
          env:
            - name: NODE_ENV
              value: production
            - name: PORT
              value: "4000"
            - name: DB_HOST
              value: cloudcart-mysql
            - name: DB_PORT
              value: "3306"
            - name: DB_USER
              value: cloudcart
            - name: DB_NAME
              value: cloudcart
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: cloudcart-secrets
                  key: DB_PASSWORD
            - name: ADMIN_API_KEY
              valueFrom:
                secretKeyRef:
                  name: cloudcart-secrets
                  key: ADMIN_API_KEY
          readinessProbe:
            httpGet:
              path: /api/health
              port: 4000
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /api/health
              port: 4000
            initialDelaySeconds: 25
            periodSeconds: 20
---
apiVersion: v1
kind: Service
metadata:
  name: cloudcart-backend
  namespace: cloudcart
spec:
  selector:
    app: cloudcart-backend
  ports:
    - name: http
      port: 4000
      targetPort: 4000
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cloudcart-frontend
  namespace: cloudcart
spec:
  replicas: 2
  selector:
    matchLabels:
      app: cloudcart-frontend
  template:
    metadata:
      labels:
        app: cloudcart-frontend
    spec:
      containers:
        - name: frontend
          image: __FRONTEND_IMAGE__
          imagePullPolicy: Always
          ports:
            - containerPort: 80
          readinessProbe:
            httpGet:
              path: /
              port: 80
            initialDelaySeconds: 5
            periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: cloudcart-frontend
  namespace: cloudcart
spec:
  type: LoadBalancer
  selector:
    app: cloudcart-frontend
  ports:
    - name: http
      port: 80
      targetPort: 80
